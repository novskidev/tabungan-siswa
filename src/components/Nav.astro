---
interface Props {
  role: 'teacher' | 'master';
  current: 'dashboard' | 'siswa' | 'transaksi' | 'guru-admin' | 'profil';
}

const { role, current } = Astro.props;

const links = [
  { key: 'dashboard', label: 'Dashboard', icon: '🏠', href: '/guru' },
  { key: 'siswa', label: 'Siswa', icon: '🧒', href: '/guru/siswa' },
  { key: 'transaksi', label: 'Transaksi', icon: '💰', href: '/guru/transaksi' },
];

const masterLinks =
  role === 'master'
    ? [
        { key: 'guru-admin', label: 'Guru', icon: '👩‍🏫', href: '/master' },
        { key: 'profil', label: 'Profil', icon: '⚙️', href: '/master/profil' },
      ]
    : [];
---

<nav class="nav-pill mb-6 flex gap-1 p-1.5 text-sm">
  {
    [...links, ...masterLinks].map((l) => (
      <a
        href={l.href}
        class:list={[
          'flex-1 rounded-full px-2 py-2 text-center transition',
          current === l.key ? 'active' : 'text-ink/55 hover:text-ink',
        ]}
      >
        <span aria-hidden="true">{l.icon}</span>{' '}
        <span class="hidden sm:inline">{l.label}</span>
      </a>
    ))
  }
  <form method="POST" action="/api/auth/logout" class="flex-1">
    <button
      type="submit"
      class="w-full rounded-full px-2 py-2 text-ink/55 transition hover:text-coral"
    >
      <span aria-hidden="true">🚪</span>{' '}
      <span class="hidden sm:inline">Keluar</span>
    </button>
  </form>
</nav>
