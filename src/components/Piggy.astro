---
// Maskot celengan — SVG buatan sendiri, tanpa aset luar.
interface Props {
  class?: string;
  coin?: boolean; // koin di atas celengan (default: true)
}
const { class: className = 'w-24 h-auto', coin = true } = Astro.props;
---

<svg
  viewBox="0 0 120 104"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role="img"
  aria-label="Maskot celengan tersenyum"
>
  {coin && (
    <g>
      <circle cx="60" cy="12" r="9" fill="#FFC53D" stroke="#3B3653" stroke-width="2.5"></circle>
      <path
        d="M60 7.5l1.4 2.9 3.2.4-2.3 2.2.6 3.1-2.9-1.5-2.9 1.5.6-3.1-2.3-2.2 3.2-.4z"
        fill="#B7791F"></path>
      <path d="M56 21c1 1.6 2.6 2.6 4 3.4" stroke="#B7791F" stroke-width="2" stroke-linecap="round"></path>
    </g>
  )}
  <!-- ekor keriting -->
  <path
    d="M14 56c-6-1-9 3-7 7 1.6 3.2 6 3 7-1"
    stroke="#3B3653"
    stroke-width="2.5"
    stroke-linecap="round"></path>
  <!-- badan -->
  <ellipse cx="62" cy="62" rx="46" ry="35" fill="#FFAEC9" stroke="#3B3653" stroke-width="3"></ellipse>
  <!-- telinga -->
  <path d="M38 32c-2-7 3-11 8-9 2 1 3 4 2 7z" fill="#FF8FB1" stroke="#3B3653" stroke-width="3" stroke-linejoin="round"></path>
  <path d="M86 32c2-7-3-11-8-9-2 1-3 4-2 7z" fill="#FF8FB1" stroke="#3B3653" stroke-width="3" stroke-linejoin="round"></path>
  <!-- celah koin -->
  <rect x="50" y="30" width="24" height="5" rx="2.5" fill="#3B3653"></rect>
  <!-- mata -->
  <circle cx="49" cy="55" r="3.4" fill="#3B3653"></circle>
  <circle cx="75" cy="55" r="3.4" fill="#3B3653"></circle>
  <circle cx="50.2" cy="53.8" r="1.1" fill="#fff"></circle>
  <circle cx="76.2" cy="53.8" r="1.1" fill="#fff"></circle>
  <!-- moncong -->
  <ellipse cx="62" cy="67" rx="13" ry="9.5" fill="#FF8FB1" stroke="#3B3653" stroke-width="2.5"></ellipse>
  <circle cx="57.5" cy="66" r="1.8" fill="#3B3653"></circle>
  <circle cx="66.5" cy="66" r="1.8" fill="#3B3653"></circle>
  <path d="M59 71.5c1.8 1.6 4.2 1.6 6 0" stroke="#3B3653" stroke-width="2" stroke-linecap="round"></path>
  <!-- pipi -->
  <ellipse cx="38" cy="66" rx="5" ry="3.4" fill="#FF7BA3" opacity="0.65"></ellipse>
  <ellipse cx="86" cy="66" rx="5" ry="3.4" fill="#FF7BA3" opacity="0.65"></ellipse>
  <!-- kaki -->
  <rect x="34" y="92" width="12" height="10" rx="5" fill="#FF8FB1" stroke="#3B3653" stroke-width="2.5"></rect>
  <rect x="78" y="92" width="12" height="10" rx="5" fill="#FF8FB1" stroke="#3B3653" stroke-width="2.5"></rect>
</svg>
