---
import Layout from '../layouts/Layout.astro';
import { getSupabase, setAuthSession } from '../lib/supabase';

const { client } = getSupabase(Astro);
await setAuthSession(Astro, client);

// Supabase baru mengirim ?code= (PKCE), bukan #access_token. Tukar di server
// lalu simpan sebagai cookie supaya POST updateUser terbaca getSupabase.
const code = (Astro.url.searchParams.get('code') ?? '').trim();
if (code) {
  const { data, error: exErr } = await client.auth.exchangeCodeForSession(code);
  if (!exErr && data.session) {
    Astro.cookies.set('sb-access-token', data.session.access_token, {
      path: '/',
      httpOnly: true,
      sameSite: 'lax',
      maxAge: 60 * 60,
    });
    Astro.cookies.set('sb-refresh-token', data.session.refresh_token, {
      path: '/',
      httpOnly: true,
      sameSite: 'lax',
      maxAge: 60 * 60 * 24 * 7,
    });
    return Astro.redirect('/ganti-password');
  }
}

let error: string | null = null;
let ok = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  if (password.length < 6) error = 'Password minimal 6 karakter.';
  else if (password !== confirm) error = 'Konfirmasi password tidak sama.';
  else {
    const { error: pwErr } = await client.auth.updateUser({ password });
    if (pwErr) error = `Gagal menyimpan password: ${pwErr.message}`;
    else ok = true;
  }
}
---

<Layout title="Ganti Password — Tabungan SDN Klagen 1">
  <section class="space-y-6 pt-6">
    <header class="space-y-1 text-center">
      <h1 class="text-2xl font-semibold">Ganti Password</h1>
      <p class="text-sm text-ink/60">Masukkan password baru Anda.</p>
    </header>

    {ok ? (
      <div class="space-y-4 text-center">
        <p role="status" class="rounded-md bg-green-100 px-3 py-2 text-sm text-green-800">
          Password berhasil diganti. Silakan masuk.
        </p>
        <a href="/login" class="inline-block rounded-full btn-candy-brand px-4 py-2.5 text-base font-medium">
          Ke Halaman Login
        </a>
      </div>
    ) : (
      <form method="POST" class="space-y-4 rounded-2xl card-soft p-6">
        <div id="no-session" class="hidden rounded-md bg-red-100 px-3 py-2 text-sm text-red-800">
          Link reset tidak valid atau sudah kedaluwarsa. Minta link baru ke master.
        </div>
        <label class="block text-sm">
          <span class="mb-1 block font-medium">Password baru</span>
          <input
            name="password"
            type="password"
            required
            minlength="6"
            autocomplete="new-password"
            class="w-full rounded-xl border-2 border-ink/10 bg-white px-3 py-2 text-base outline-none focus:border-brand"
          />
        </label>
        <label class="block text-sm">
          <span class="mb-1 block font-medium">Ulangi password baru</span>
          <input
            name="confirm"
            type="password"
            required
            minlength="6"
            autocomplete="new-password"
            class="w-full rounded-xl border-2 border-ink/10 bg-white px-3 py-2 text-base outline-none focus:border-brand"
          />
        </label>
        {error && (
          <p role="alert" class="rounded-md bg-red-100 px-3 py-2 text-sm text-red-800">
            {error}
          </p>
        )}
        <button
          type="submit"
          class="w-full rounded-full btn-candy-brand px-4 py-2.5 text-base font-medium"
        >
          Simpan Password
        </button>
      </form>
    )}
  </section>
</Layout>

<script is:inline>
  // Fallback hash implisit lama: simpan token ke cookie non-HttpOnly lalu reload.
  (function () {
    var hash = window.location.hash || '';
    var m = hash.match(/access_token=([^&]+)/);
    var warn = document.getElementById('no-session');
    if (m) {
      var token = decodeURIComponent(m[1]);
      document.cookie = 'sb-access-token=' + encodeURIComponent(token) + '; Path=/; SameSite=Lax; Max-Age=3600';
      history.replaceState(null, '', window.location.pathname);
      if (warn) warn.classList.add('hidden');
    } else if (warn) {
      warn.classList.remove('hidden');
    }
  })();
</script>
