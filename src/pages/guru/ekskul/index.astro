---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import { getSupabase, requireRole } from '../../../lib/supabase';
import {
  formatKamisLabel,
  getThursdayOfWeek,
  getAdjacentThursday,
  getEkskulStatusBadge,
} from '../../../lib/ekskul';
import { formatRupiah } from '../../../lib/transactions';
import type { EkskulPaymentRow, EkskulStatus } from '../../../types/database';

const profile = await requireRole(Astro, 'teacher');
if (profile.role !== 'master' && !profile.is_ekskul_teacher) {
  return Astro.redirect('/guru');
}

const { client } = getSupabase(Astro);

let error: string | null = null;
let notice: string | null = (Astro.url.searchParams.get('notice') ?? '').trim() || null;

// Date resolution
let rawDate = (Astro.url.searchParams.get('date') ?? '').trim();
if (!/^\d{4}-\d{2}-\d{2}$/.test(rawDate)) {
  rawDate = getThursdayOfWeek(new Date());
}
const selectedDate = rawDate;
const prevDate = getAdjacentThursday(selectedDate, -1);
const nextDate = getAdjacentThursday(selectedDate, 1);
const kamisLabel = formatKamisLabel(selectedDate);

// Class filter
const kelas = (Astro.url.searchParams.get('kelas') ?? '').trim();

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'save_status') {
    const studentId = String(form.get('student_id') ?? '');
    const paymentDate = String(form.get('payment_date') ?? selectedDate);
    const status = String(form.get('status') ?? '') as EkskulStatus;
    const note = String(form.get('note') ?? '').trim();

    if (!studentId || !['paid', 'unpaid', 'absent'].includes(status)) {
      error = 'Data pembayaran tidak valid.';
    } else {
      const { error: rpcError } = await client.rpc('save_ekskul_payment', {
        p_student_id: studentId,
        p_payment_date: paymentDate,
        p_status: status,
        p_note: note || null,
      });
      if (rpcError) {
        error = `Gagal menyimpan: ${rpcError.message}`;
      } else {
        return Astro.redirect(`/guru/ekskul?date=${paymentDate}${kelas ? `&kelas=${kelas}` : ''}`);
      }
    }
  } else if (action === 'bulk_paid') {
    const studentIds = form.getAll('student_ids').map(String);
    const paymentDate = String(form.get('payment_date') ?? selectedDate);

    if (studentIds.length === 0) {
      error = 'Tidak ada siswa yang dipilih.';
    } else {
      const { error: rpcError } = await client.rpc('bulk_save_ekskul_payments', {
        p_student_ids: studentIds,
        p_payment_date: paymentDate,
        p_status: 'paid',
      });
      if (rpcError) {
        error = `Gagal menyimpan massal: ${rpcError.message}`;
      } else {
        return Astro.redirect(`/guru/ekskul?date=${paymentDate}${kelas ? `&kelas=${kelas}` : ''}&notice=${encodeURIComponent('Semua siswa berhasil ditandai Lunas.')}`);
      }
    }
  } else if (action === 'settle_arrears') {
    const studentId = String(form.get('student_id') ?? '');

    if (!studentId) {
      error = 'ID siswa tidak valid.';
    } else {
      const { data: updatedCount, error: rpcError } = await client.rpc('pay_all_ekskul_arrears', {
        p_student_id: studentId,
      });
      if (rpcError) {
        error = `Gagal melunasi tunggakan: ${rpcError.message}`;
      } else {
        const count = Number(updatedCount ?? 0);
        notice = count > 0 ? `${count} tunggakan berhasil dilunasi sekaligus.` : 'Tidak ada tunggakan.';
        return Astro.redirect(
          `/guru/ekskul?date=${selectedDate}${kelas ? `&kelas=${kelas}` : ''}&notice=${encodeURIComponent(notice)}`,
        );
      }
    }
  }
}

// Fetch active students
let studentQuery = client
  .from('students')
  .select('id, nis, full_name, class_name')
  .eq('is_active', true)
  .order('class_name')
  .order('full_name');

if (kelas) {
  studentQuery = studentQuery.eq('class_name', kelas);
}
const { data: studentRows, error: studentError } = await studentQuery;
if (studentError && !error) error = `Gagal memuat siswa: ${studentError.message}`;

const students = (studentRows ?? []) as {
  id: string;
  nis: string | null;
  full_name: string;
  class_name: string;
}[];

// Fetch payments for selected Thursday
const { data: paymentRows, error: paymentError } = await client
  .from('ekskul_payments')
  .select('id, student_id, payment_date, status, amount, note, recorded_by, created_at, updated_at')
  .eq('payment_date', selectedDate);

if (paymentError && !error) error = `Gagal memuat catatan iuran: ${paymentError.message}`;

const paymentMap = new Map<string, EkskulPaymentRow>();
for (const row of (paymentRows ?? []) as EkskulPaymentRow[]) {
  paymentMap.set(row.student_id, row);
}

// Fetch all unpaid arrears for students
const { data: allUnpaidRows } = await client
  .from('ekskul_payments')
  .select('student_id, amount')
  .eq('status', 'unpaid');

const arrearsMap = new Map<string, { count: number; total: number }>();
for (const row of (allUnpaidRows ?? []) as { student_id: string; amount: number }[]) {
  const cur = arrearsMap.get(row.student_id) ?? { count: 0, total: 0 };
  arrearsMap.set(row.student_id, {
    count: cur.count + 1,
    total: cur.total + Number(row.amount || 3000),
  });
}

// Summary stats for current view
let countPaid = 0;
let countUnpaid = 0;
let countAbsent = 0;
for (const s of students) {
  const p = paymentMap.get(s.id);
  if (!p) continue;
  if (p.status === 'paid') countPaid++;
  else if (p.status === 'unpaid') countUnpaid++;
  else if (p.status === 'absent') countAbsent++;
}
const countUnrecorded = students.length - (countPaid + countUnpaid + countAbsent);
const totalCollected = countPaid * 3000;
---

<Layout title="Iuran Ekskul — Tabungan SDN Klagen 1" wide>
  <Nav role={profile.role} current="ekskul" isEkskulTeacher={profile.is_ekskul_teacher} />

  <header class="mb-3 flex items-center justify-between">
    <div>
      <h1 class="text-xl font-semibold leading-tight">Iuran Ekskul</h1>
      <p class="text-xs text-ink/60">Rp3.000 / siswa tiap hari Kamis (Tunai langsung).</p>
    </div>
  </header>

  {error && (
    <p role="alert" class="mb-3 rounded-md bg-red-100 px-3 py-2 text-sm text-red-800">
      {error}
    </p>
  )}
  {notice && (
    <p role="status" class="mb-3 rounded-md bg-green-100 px-3 py-2 text-sm text-green-800">
      {notice}
    </p>
  )}

  <!-- Date Navigation Bar -->
  <section class="mb-3 rounded-2xl card-soft p-3">
    <div class="flex items-center justify-between gap-2">
      <a
        href={`/guru/ekskul?date=${prevDate}${kelas ? `&kelas=${kelas}` : ''}`}
        class="shrink-0 rounded-xl border border-ink/10 bg-white px-3 py-2 text-xs font-semibold text-ink hover:bg-ink/5 active:scale-95 transition"
        title="Kamis sebelumnya"
      >
        ← Lalu
      </a>
      <div class="text-center min-w-0 flex-1 px-1">
        <a
          href={`/guru/ekskul?date=${getThursdayOfWeek(new Date())}${kelas ? `&kelas=${kelas}` : ''}`}
          class="inline-block text-xs sm:text-sm font-semibold text-brand hover:underline truncate max-w-full"
          title="Klik untuk kembali ke Kamis minggu ini"
        >
          {kamisLabel}
        </a>
        <span class="block text-[10px] text-ink/40">Kamis Minggu Ini</span>
      </div>
      <a
        href={`/guru/ekskul?date=${nextDate}${kelas ? `&kelas=${kelas}` : ''}`}
        class="shrink-0 rounded-xl border border-ink/10 bg-white px-3 py-2 text-xs font-semibold text-ink hover:bg-ink/5 active:scale-95 transition"
        title="Kamis berikutnya"
      >
        Depan →
      </a>
    </div>
  </section>

  <!-- Compact Summary Bar -->
  <section class="mb-3 rounded-2xl card-cute p-3">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
      <div class="flex items-center gap-1.5 font-medium">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-500 shrink-0"></span>
        <span class="text-ink/60">Terkumpul:</span>
        <span class="font-bold text-emerald-800 text-sm">{formatRupiah(totalCollected)}</span>
        <span class="text-[11px] text-ink/50">({countPaid} siswa)</span>
      </div>
      <div class="flex items-center gap-1.5 text-[11px] font-medium text-ink/70 flex-wrap">
        <span class="rounded-full bg-amber-100 px-2 py-0.5 text-amber-800">
          ⚠️ {countUnpaid} Nunggak
        </span>
        <span class="rounded-full bg-ink/5 px-2 py-0.5 text-ink/60">
          ✕ {countAbsent} Izin
        </span>
        <span class="rounded-full bg-blue-50 px-2 py-0.5 text-blue-700">
          {countUnrecorded} Belum
        </span>
      </div>
    </div>
  </section>

  <!-- Filter & Bulk Actions -->
  <section class="mb-3 space-y-2.5">
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs">
      <a
        href={`/guru/ekskul?date=${selectedDate}`}
        class:list={[
          'shrink-0 rounded-full px-3 py-1.5 font-medium transition cursor-pointer',
          !kelas ? 'bg-brand text-white shadow-xs' : 'bg-white border border-ink/10 text-ink/70 hover:bg-ink/5',
        ]}
      >
        Semua Kelas
      </a>
      {['1', '2', '3', '4', '5', '6'].map((k) => (
        <a
          href={`/guru/ekskul?date=${selectedDate}&kelas=${k}`}
          class:list={[
            'shrink-0 rounded-full px-3 py-1.5 font-medium transition cursor-pointer',
            kelas === k ? 'bg-brand text-white shadow-xs' : 'bg-white border border-ink/10 text-ink/70 hover:bg-ink/5',
          ]}
        >
          Kelas {k}
        </a>
      ))}
    </div>

    {students.length > 0 && (
      <form method="POST">
        <input type="hidden" name="action" value="bulk_paid" />
        <input type="hidden" name="payment_date" value={selectedDate} />
        {students.map((s) => (
          <input type="hidden" name="student_ids" value={s.id} />
        ))}
        <button
          type="submit"
          onclick="return confirm('Tandai semua siswa yang tampil sebagai Masuk & Lunas?')"
          class="w-full sm:w-auto rounded-xl bg-emerald-600 px-4 py-2 text-xs font-semibold text-white shadow-xs transition hover:bg-emerald-700 active:scale-[0.98] cursor-pointer flex items-center justify-center gap-1.5"
        >
          <span>✓</span> <span>Tandai Semua Masuk & Lunas</span>
        </button>
      </form>
    )}
  </section>

  <!-- Student Checklist -->
  <section>
    {students.length === 0 ? (
      <div class="rounded-2xl card-soft p-8 text-center text-ink/60">
        Tidak ada data siswa aktif{kelas ? ` di Kelas ${kelas}` : ''}.
      </div>
    ) : (
      <ul class="divide-y divide-ink/10 rounded-2xl card-cute overflow-hidden">
        {students.map((s, idx) => {
          const payment = paymentMap.get(s.id);
          const currentStatus = payment?.status ?? null;
          const badge = getEkskulStatusBadge(currentStatus);

          return (
            <li class="p-3.5 sm:p-4 transition hover:bg-ink/[0.01]">
              <!-- Header info siswa + badge status -->
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-xs font-mono text-ink/40">{idx + 1}.</span>
                    <span class="font-semibold text-ink text-sm sm:text-base leading-snug">{s.full_name}</span>
                    <span class="rounded-full bg-sun-soft px-2 py-0.5 text-[11px] font-medium text-ink/70">
                      Kelas {s.class_name}
                    </span>
                    {s.nis && <span class="text-[11px] text-ink/40">NIS {s.nis}</span>}
                  </div>
                  {payment?.note && (
                    <p class="mt-0.5 text-xs text-ink/50 italic">"{payment.note}"</p>
                  )}
                </div>

                <span class={`shrink-0 rounded-md px-2 py-0.5 text-[11px] font-semibold border ${badge.class}`}>
                  {badge.label}
                </span>
              </div>

              <!-- Notifikasi Tunggakan & Tombol Lunasi Sekaligus -->
              {(() => {
                const arrears = arrearsMap.get(s.id);
                if (!arrears || arrears.count === 0) return null;
                return (
                  <div class="mt-2.5 flex items-center justify-between gap-2 rounded-xl bg-amber-50 border border-amber-200/80 p-2 text-xs">
                    <span class="text-amber-800 font-medium">
                      ⚠️ {arrears.count}x tunggakan ({formatRupiah(arrears.total)})
                    </span>
                    <form method="POST" class="inline">
                      <input type="hidden" name="action" value="settle_arrears" />
                      <input type="hidden" name="student_id" value={s.id} />
                      <input type="hidden" name="student_name" value={s.full_name} />
                      <button
                        type="submit"
                        onclick={`return confirm('Lunasi ${arrears.count} pertemuan tunggakan (${formatRupiah(arrears.total)}) untuk ${s.full_name}?')`}
                        class="rounded-lg bg-emerald-600 px-2.5 py-1 text-[11px] font-semibold text-white shadow-xs transition hover:bg-emerald-700 active:scale-95 cursor-pointer shrink-0"
                      >
                        ✓ Lunasi Semua
                      </button>
                    </form>
                  </div>
                );
              })()}

              <!-- Segmented Touch Control (3 Segmen Penuh untuk Jempol) -->
              <div class="mt-3 grid grid-cols-3 gap-1.5">
                <form method="POST" class="w-full">
                  <input type="hidden" name="action" value="save_status" />
                  <input type="hidden" name="student_id" value={s.id} />
                  <input type="hidden" name="payment_date" value={selectedDate} />
                  <input type="hidden" name="status" value="paid" />
                  <button
                    type="submit"
                    title="Tandai Lunas Rp3.000"
                    class:list={[
                      'w-full min-h-[42px] rounded-xl py-2 px-1 text-xs font-semibold transition cursor-pointer border flex items-center justify-center gap-1 active:scale-95',
                      currentStatus === 'paid'
                        ? 'bg-emerald-600 text-white border-emerald-600 shadow-xs ring-2 ring-emerald-600/20'
                        : 'bg-white text-emerald-800 border-ink/10 hover:bg-emerald-50/50',
                    ]}
                  >
                    <span>✓</span> <span>Lunas</span>
                  </button>
                </form>

                <form method="POST" class="w-full">
                  <input type="hidden" name="action" value="save_status" />
                  <input type="hidden" name="student_id" value={s.id} />
                  <input type="hidden" name="payment_date" value={selectedDate} />
                  <input type="hidden" name="status" value="unpaid" />
                  <button
                    type="submit"
                    title="Tandai Masuk tapi belum bayar (Tunggakan)"
                    class:list={[
                      'w-full min-h-[42px] rounded-xl py-2 px-1 text-xs font-semibold transition cursor-pointer border flex items-center justify-center gap-1 active:scale-95',
                      currentStatus === 'unpaid'
                        ? 'bg-amber-600 text-white border-amber-600 shadow-xs ring-2 ring-amber-600/20'
                        : 'bg-white text-amber-800 border-ink/10 hover:bg-amber-50/50',
                    ]}
                  >
                    <span>⚠️</span> <span>Nunggak</span>
                  </button>
                </form>

                <form method="POST" class="w-full">
                  <input type="hidden" name="action" value="save_status" />
                  <input type="hidden" name="student_id" value={s.id} />
                  <input type="hidden" name="payment_date" value={selectedDate} />
                  <input type="hidden" name="status" value="absent" />
                  <button
                    type="submit"
                    title="Tandai Tidak Masuk (Bebas Iuran)"
                    class:list={[
                      'w-full min-h-[42px] rounded-xl py-2 px-1 text-xs font-semibold transition cursor-pointer border flex items-center justify-center gap-1 active:scale-95',
                      currentStatus === 'absent'
                        ? 'bg-gray-700 text-white border-gray-700 shadow-xs ring-2 ring-gray-700/20'
                        : 'bg-white text-gray-700 border-ink/10 hover:bg-gray-100/50',
                    ]}
                  >
                    <span>✕</span> <span>Izin</span>
                  </button>
                </form>
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</Layout>
