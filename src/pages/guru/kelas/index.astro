---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import { getSupabase, requireRole } from '../../../lib/supabase';

await requireRole(Astro, 'teacher');
const { client } = getSupabase(Astro);

const { data: classes } = await client
  .from('classes')
  .select('id, name, academic_year, created_at')
  .order('name');
---

<Layout title="Kelas — Tabungan SDN Klagen 1" wide>
  <Nav role="teacher" current="kelas" />

  <header class="mb-4">
    <h1 class="text-xl font-semibold">Kelas</h1>
    <p class="text-sm text-ink/60">Daftar kelas aktif.</p>
  </header>

  <ul class="divide-y divide-ink/10 rounded-xl bg-white shadow-sm">
    {
      classes && classes.length > 0 ? (
        classes.map((c) => (
          <li class="flex items-center justify-between px-4 py-3">
            <div>
              <p class="font-medium">{c.name}</p>
              <p class="text-xs text-ink/50">{c.academic_year}</p>
            </div>
            <a
              href={`/guru/siswa?kelas=${c.id}`}
              class="text-sm text-brand hover:underline"
            >
              Lihat siswa
            </a>
          </li>
        ))
      ) : (
        <li class="px-4 py-8 text-center text-sm text-ink/50">
          Belum ada kelas.
        </li>
      )
    }
  </ul>
</Layout>
