---
import Layout from '../../../../layouts/Layout.astro';
import Nav from '../../../../components/Nav.astro';
import { getSupabase, requireRole } from '../../../../lib/supabase';
import {
  formatRupiah,
  formatTimestamp,
  getStudentBalance,
  getStudentTransactions,
} from '../../../../lib/transactions';
import {
  asCreator,
  type StudentRow,
} from '../../../../types/database';

const profile = await requireRole(Astro, 'teacher');
const { client } = getSupabase(Astro);

const { id } = Astro.params;
if (!id) return Astro.redirect('/guru/siswa');

const { data: studentRaw, error } = await client
  .from('students')
  .select('id, nis, full_name, class_name, public_code, is_active, created_at, updated_at')
  .eq('id', id)
  .maybeSingle();

const student = studentRaw as unknown as StudentRow | null;

if (error || !student) {
  return Astro.redirect('/guru/siswa');
}

let pinMessage: string | null = null;
let freshPin: string | null = null;
let balanceMessage: string | null = null;
let deleteMessage: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action === 'toggle_active') {
    await client
      .from('students')
      .update({ is_active: !student.is_active } as Record<string, unknown>)
      .eq('id', id);
    return Astro.redirect(`/guru/siswa/${id}`);
  }
  if (action === 'delete_student') {
    const { error: deleteError } = await client.rpc('delete_student', {
      p_student_id: id,
    });
    if (deleteError) deleteMessage = `Gagal menghapus siswa: ${deleteError.message}`;
    else return Astro.redirect('/guru/siswa');
  }
  if (action === 'reset_balance') {
    const { error: resetError } = await client.rpc('reset_student_balance', {
      p_student_id: id,
    });
    if (resetError) balanceMessage = `Gagal mereset saldo: ${resetError.message}`;
    else return Astro.redirect(`/guru/siswa/${id}`);
  }
  if (action === 'reset_pin') {
    const { data: pin, error: pinError } = await client.rpc('reset_student_pin', {
      p_student_id: id,
    });
    if (pinError) pinMessage = 'Gagal mereset PIN. Silakan coba lagi.';
    else freshPin = pin as string;
  }
}

const balance = await getStudentBalance(Astro, id);
const transactions = await getStudentTransactions(client, id, 100);

// Index correction rows by id for quick label rendering.
const correctionIds = transactions
  .map((t) => t.correction_of)
  .filter((v): v is string => Boolean(v));
const correctedSet = new Set(correctionIds);
---

<Layout title={`${student.full_name} — Tabungan SDN Klagen 1`} wide>
  <Nav role={profile.role} current="siswa" />

  <header class="mb-4 flex items-center justify-between">
    <a href="/guru/siswa" class="text-sm text-ink/60 underline hover:text-ink">
      ← Kembali
    </a>
    <div class="flex gap-2">
      <form method="POST" class="inline">
        <input type="hidden" name="action" value="toggle_active" />
        <button
          class="rounded-md bg-ink/5 px-3 py-1.5 text-sm hover:bg-ink/10"
        >
          {student.is_active ? 'Nonaktifkan' : 'Aktifkan'}
        </button>
      </form>
      <a
        href={`/guru/siswa/${student.id}/edit`}
        class="rounded-md bg-ink/5 px-3 py-1.5 text-sm hover:bg-ink/10"
      >
        Edit
      </a>
      <form method="POST" id="delete-student-form" class="inline">
        <input type="hidden" name="action" value="delete_student" />
        <button
          class="rounded-md bg-red-100 px-3 py-1.5 text-sm text-red-800 hover:bg-red-200"
        >
          Hapus
        </button>
      </form>
    </div>
  </header>

  <section class="space-y-5">
    <div>
      <h1 class="text-2xl font-semibold">{student.full_name}</h1>
      <p class="text-sm text-ink/60">
        Kelas {student.class_name}{student.nis ? ` · NIS ${student.nis}` : ''}
        {student.is_active ? '' : ' · Tidak Aktif'}
      </p>
    </div>

    {balanceMessage && (
      <p role="alert" class="rounded-md bg-red-100 px-3 py-2 text-sm text-red-800">
        {balanceMessage}
      </p>
    )}

    <div class="grid grid-cols-3 gap-2">
      <div class="rounded-xl bg-brand-soft/60 p-4 shadow-sm">
        <p class="text-xs text-ink/60">Saldo</p>
        <p class="mt-1 text-lg font-semibold">{formatRupiah(balance.balance)}</p>
      </div>
      <div class="rounded-xl bg-white p-4 shadow-sm">
        <p class="text-xs text-ink/60">Total Setoran</p>
        <p class="mt-1 text-lg font-semibold text-green-700">
          {formatRupiah(balance.totalDeposit)}
        </p>
      </div>
      <div class="rounded-xl bg-white p-4 shadow-sm">
        <p class="text-xs text-ink/60">Total Penarikan</p>
        <p class="mt-1 text-lg font-semibold text-red-700">
          {formatRupiah(balance.totalWithdrawal)}
        </p>
      </div>
    </div>

    {balance.balance > 0 && (
      <form method="POST" id="reset-balance-form" class="text-center">
        <input type="hidden" name="action" value="reset_balance" />
        <button class="text-xs text-ink/40 underline hover:text-red-700">
          Reset saldo ke 0 (testing)
        </button>
      </form>
    )}

    {student.is_active && (
      <div class="mt-2 grid grid-cols-2 gap-2">
        <a
          href={`/guru?siswa=${student.id}&mode=deposit`}
          class="rounded-lg bg-brand py-3 text-center text-sm font-medium text-white hover:bg-brand/90"
        >
          + Tambah Setoran
        </a>
        <a
          href={`/guru?siswa=${student.id}&mode=withdrawal`}
          class="rounded-lg bg-red-600 py-3 text-center text-sm font-medium text-white hover:bg-red-700"
        >
          Tarik Uang
        </a>
      </div>
    )}

    <dl class="divide-y divide-ink/10 rounded-xl bg-white shadow-sm">
      <div class="flex justify-between gap-3 px-4 py-3 text-sm">
        <dt class="text-ink/60">Halaman publik</dt>
        <dd class="font-medium">
          <a href={`/siswa/${student.public_code}`} class="text-brand hover:underline">
            /siswa/{student.public_code}
          </a>
        </dd>
      </div>
      <div class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
        <dt class="text-ink/60">PIN orang tua</dt>
        <dd>
          {freshPin ? (
            <span class="font-mono font-semibold">PIN baru: {freshPin}</span>
          ) : (
            <form method="POST" class="inline" id="reset-pin-form">
              <input type="hidden" name="action" value="reset_pin" />
              <button class="rounded-md bg-ink/5 px-3 py-1.5 text-sm hover:bg-ink/10">
                Reset PIN
              </button>
            </form>
          )}
        </dd>
      </div>
      {pinMessage && (
        <div class="px-4 py-2 text-xs text-red-700">{pinMessage}</div>
      )}
      <div class="flex justify-between px-4 py-3 text-sm">
        <dt class="text-ink/60">Terdaftar</dt>
        <dd class="text-xs text-ink/70">
          {new Date(student.created_at).toLocaleDateString('id-ID')}
        </dd>
      </div>
    </dl>

    {deleteMessage && (
      <p role="alert" class="rounded-md bg-red-100 px-3 py-2 text-sm text-red-800">
        {deleteMessage}
      </p>
    )}

    <section>
      <h2 class="mb-3 text-sm font-medium text-ink/60">Riwayat Transaksi</h2>
      {transactions.length > 0 ? (
        <ul class="divide-y divide-ink/10 rounded-xl bg-white shadow-sm">
          {transactions.map((t) => {
            const creator = asCreator(t.creator);
            const isCorrection = t.correction_of !== null;
            return (
              <li class="px-4 py-3 text-sm">
                <div class="flex items-center justify-between">
                  <p class="font-medium">
                    {isCorrection ? 'Koreksi' : t.type === 'deposit' ? 'Setoran' : 'Penarikan'}
                  </p>
                  <p
                    class:list={[
                      'font-medium',
                      t.type === 'deposit' ? 'text-green-700' : 'text-red-700',
                    ]}
                  >
                    {t.type === 'deposit' ? '+' : '−'} {formatRupiah(Number(t.amount))}
                  </p>
                </div>
                <p class="mt-1 text-xs text-ink/50">
                  {formatTimestamp(t.created_at)}
                  {creator && ` · oleh ${creator.full_name}`}
                </p>
                {t.note && (
                  <p class="mt-1 text-xs text-ink/70">"{t.note}"</p>
                )}
                {isCorrection && t.correction_reason && (
                  <p class="mt-1 text-xs text-ink/70">
                    Alasan: {t.correction_reason}
                  </p>
                )}
                {!isCorrection && !correctedSet.has(t.id) && (
                  <a
                    href={`/guru/transaksi/${t.id}/koreksi`}
                    class="mt-1 inline-block text-xs text-brand hover:underline"
                  >
                    Koreksi
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="rounded-xl bg-white px-4 py-8 text-center text-sm text-ink/50 shadow-sm">
          Belum ada transaksi.
        </p>
      )}
    </section>
  </section>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById('reset-pin-form');
    if (form) form.addEventListener('submit', function (e) {
      if (!window.confirm('Reset PIN siswa ini ke PIN awal kelas?')) e.preventDefault();
    });
    var delForm = document.getElementById('delete-student-form');
    if (delForm) delForm.addEventListener('submit', function (e) {
      if (!window.confirm('Hapus siswa ini beserta SEMUA riwayat transaksinya? Tidak bisa dibatalkan.')) e.preventDefault();
    });
    var rbForm = document.getElementById('reset-balance-form');
    if (rbForm) rbForm.addEventListener('submit', function (e) {
      if (!window.confirm('Reset saldo ke 0? Semua riwayat transaksi siswa ini dihapus.')) e.preventDefault();
    });
  })();
</script>
