---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import { getSupabase, requireRole } from '../../../lib/supabase';
import { formatRupiah, getStudentBalance } from '../../../lib/transactions';
import { asClass, asParent, type StudentWithRelations } from '../../../types/database';

await requireRole(Astro, 'teacher');
const { client } = getSupabase(Astro);

const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') ?? '').trim();
const kelas = (url.searchParams.get('kelas') ?? '').trim();

let classes: { id: string; name: string }[] = [];
{
  const { data } = await client
    .from('classes')
    .select('id, name')
    .order('name');
  classes = (data ?? []) as { id: string; name: string }[];
}

let students: (StudentWithRelations & { balance: number })[] = [];
{
  let query = client
    .from('students')
    .select(
      'id, nis, full_name, class_id, parent_id, created_at, updated_at, class:classes(id, name, academic_year), parent:profiles!students_parent_id_fkey(id, full_name)',
    )
    .order('full_name');
  if (q) {
    query = query.or(`full_name.ilike.%${q}%,nis.ilike.%${q}%`);
  }
  if (kelas) {
    query = query.eq('class_id', kelas);
  }
  const { data } = await query;
  const base = (data as unknown as StudentWithRelations[] | null) ?? [];
  students = await Promise.all(
    base.map(async (s) => {
      const bal = await getStudentBalance(Astro, s.id);
      return { ...s, balance: bal.balance };
    }),
  );
}
---

<Layout title="Siswa — Tabungan SDN Klagen 1" wide>
  <Nav role="teacher" current="siswa" />

  <header class="mb-4 flex items-center justify-between">
    <h1 class="text-xl font-semibold">Daftar Siswa</h1>
    <a
      href="/guru/siswa/new"
      class="rounded-md bg-brand px-3 py-1.5 text-sm font-medium text-white hover:bg-brand/90"
    >
      + Tambah Siswa
    </a>
  </header>

  <form method="GET" class="mb-3 flex flex-col gap-2 sm:flex-row">
    <input
      name="q"
      value={q}
      placeholder="Cari nama atau NIS"
      class="flex-1 rounded-md border border-ink/15 bg-white px-3 py-2 text-sm outline-none focus:border-brand"
    />
    <select
      name="kelas"
      class="rounded-md border border-ink/15 bg-white px-3 py-2 text-sm outline-none focus:border-brand"
    >
      <option value="">Semua Kelas</option>
      {classes.map((c) => (
        <option value={c.id} selected={c.id === kelas}>{c.name}</option>
      ))}
    </select>
    <button class="rounded-md bg-ink/5 px-3 py-2 text-sm font-medium hover:bg-ink/10">
      Cari
    </button>
  </form>

  {students.length > 0 ? (
    <>
      <ul class="divide-y divide-ink/10 rounded-xl bg-white shadow-sm sm:hidden">
        {students.map((s) => (
          <li>
            <a
              href={`/guru/siswa/${s.id}`}
              class="block px-4 py-3 hover:bg-ink/5"
            >
              <div class="flex items-baseline justify-between">
                <p class="font-medium">{s.full_name}</p>
                <p class="text-sm font-semibold">{formatRupiah(s.balance)}</p>
              </div>
              <p class="mt-0.5 text-xs text-ink/50">
                Kelas {asClass(s.class)?.name ?? '—'} · NIS {s.nis}
              </p>
              <p class="mt-0.5 text-xs text-ink/60">
                Orang tua: {asParent(s.parent)?.full_name ?? 'Belum ada'}
              </p>
            </a>
          </li>
        ))}
      </ul>

      <div class="hidden overflow-hidden rounded-xl bg-white shadow-sm sm:block">
        <table class="w-full text-sm">
          <thead class="bg-brand-soft/40 text-left text-xs text-ink/60">
            <tr>
              <th class="px-4 py-2 font-medium">Nama</th>
              <th class="px-4 py-2 font-medium">Kelas</th>
              <th class="px-4 py-2 font-medium">Saldo</th>
              <th class="px-4 py-2 font-medium">Orang Tua</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink/10">
            {students.map((s) => (
              <tr class="hover:bg-ink/5">
                <td class="px-4 py-2 font-medium">
                  <a href={`/guru/siswa/${s.id}`} class="hover:underline">
                    {s.full_name}
                  </a>
                  <p class="text-xs text-ink/50">NIS {s.nis}</p>
                </td>
                <td class="px-4 py-2">{asClass(s.class)?.name ?? '—'}</td>
                <td class="px-4 py-2 font-semibold">{formatRupiah(s.balance)}</td>
                <td class="px-4 py-2 text-ink/70">
                  {asParent(s.parent)?.full_name ?? 'Belum ada'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ) : (
    <p class="rounded-xl bg-white p-6 text-center text-sm text-ink/60 shadow-sm">
      {q || kelas ? 'Siswa tidak ditemukan.' : 'Belum ada siswa.'}
    </p>
  )}
</Layout>
