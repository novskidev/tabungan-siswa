---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import { getSupabase, requireRole } from '../../../lib/supabase';
import { defaultPinForClass } from '../../../lib/pin';

const profile = await requireRole(Astro, 'teacher');
const { client } = getSupabase(Astro);

let error: string | null = null;
let created: { full_name: string; class_name: string; public_code: string; default_pin: string } | null = null;
let form = { full_name: '', nis: '', class_name: '' };
// Guru terkunci ke kelasnya; master bebas memilih.
const teacherClass = profile.role === 'teacher' ? profile.class_name : null;
if (profile.role === 'teacher' && !teacherClass) {
  error = 'Master belum menetapkan kelas Anda. Hubungi master sekolah.';
}

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  form = {
    full_name: String(data.get('full_name') ?? '').trim(),
    nis: String(data.get('nis') ?? '').trim(),
    class_name: teacherClass ?? String(data.get('class_name') ?? '').trim(),
  };

  if (!form.full_name) error = 'Nama wajib diisi.';
  else if (!form.class_name) error = 'Kelas wajib diisi.';
  else {
    const { data: rpc, error: rpcError } = await client.rpc('create_student', {
      p_full_name: form.full_name,
      p_class_name: form.class_name,
      p_nis: form.nis || null,
    });
    if (rpcError) {
      error = rpcError.message.includes('NIS')
        ? 'NIS sudah dipakai siswa lain.'
        : `Gagal menambah siswa: ${rpcError.message}`;
    } else {
      const rows = rpc as { full_name: string; class_name: string; public_code: string; default_pin: string }[] | null;
      created = rows?.[0] ?? null;
      form = { full_name: '', nis: '', class_name: '' };
    }
  }
}

const previewPin = form.class_name ? defaultPinForClass(form.class_name) : '';
---

<Layout title="Tambah Siswa — Tabungan SDN Klagen 1" wide>
  <Nav role={profile.role} current="siswa" />

  <header class="mb-4 flex items-center justify-between">
    <h1 class="text-xl font-semibold">Tambah Siswa</h1>
    <a href="/guru/siswa" class="text-sm text-ink/60 underline hover:text-ink">
      Kembali
    </a>
  </header>

  {created && (
    <div
      role="status"
      class="mb-4 rounded-md bg-green-100 px-3 py-2 text-sm text-green-800"
    >
      <p class="font-medium">✅ {created.full_name} berhasil ditambahkan.</p>
      <p class="mt-1">Kelas {created.class_name} · PIN awal: <span class="font-mono font-semibold">{created.default_pin}</span></p>
      <p class="mt-1 text-xs">Halaman publik: <a href={`/siswa/${created.public_code}`} class="underline">/siswa/{created.public_code}</a></p>
    </div>
  )}

  {error && (
    <div role="alert" class="mb-4 rounded-md bg-red-100 px-3 py-2 text-sm text-red-800">
      {error}
    </div>
  )}

  <form method="POST" class="space-y-4 rounded-xl bg-brand-soft/40 p-5 shadow-sm">
    <label class="block text-sm">
      <span class="mb-1 block font-medium">Nama siswa</span>
      <input
        name="full_name"
        value={form.full_name}
        required
        class="w-full rounded-md border border-ink/15 bg-white px-3 py-2 text-base outline-none focus:border-brand"
      />
    </label>

    <label class="block text-sm">
      <span class="mb-1 block font-medium">NIS <span class="text-xs text-ink/50">(opsional)</span></span>
      <input
        name="nis"
        value={form.nis}
        class="w-full rounded-md border border-ink/15 bg-white px-3 py-2 text-base outline-none focus:border-brand"
      />
    </label>

    <label class="block text-sm">
      <span class="mb-1 block font-medium">Kelas</span>
      {teacherClass ? (
        <>
          <input type="hidden" name="class_name" value={teacherClass} />
          <input
            value={`Kelas ${teacherClass}`}
            disabled
            class="w-full rounded-md border border-ink/15 bg-ink/5 px-3 py-2 text-base"
          />
        </>
      ) : (
        <select
          name="class_name"
          required
          class="w-full rounded-md border border-ink/15 bg-white px-3 py-2 text-base outline-none focus:border-brand"
        >
          <option value="" disabled selected>Pilih kelas</option>
          {['1', '2', '3', '4', '5', '6'].map((k) => <option value={k}>Kelas {k}</option>)}
        </select>
      )}
      <span class="mt-1 block text-xs text-ink/50">
        PIN awal otomatis: {previewPin ? <span class="font-mono font-semibold">{previewPin}</span> : 'ikuti digit pertama kelas ×4'}.
      </span>
    </label>

    <button
      type="submit"
      class="w-full rounded-lg bg-brand px-4 py-2.5 text-base font-medium text-white transition hover:bg-brand/90"
    >
      Simpan
    </button>
  </form>
</Layout>
