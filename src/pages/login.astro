---
import Layout from '../layouts/Layout.astro';
import Piggy from '../components/Piggy.astro';
import { getCurrentUser } from '../lib/supabase';

let error: string | null = null;
let loading = false;

const err = Astro.url.searchParams.get('error');
if (err === 'empty') error = 'Email dan password wajib diisi.';
else if (err === 'bad-pass') error = 'Email atau password salah.';
else if (err === 'auth-failed') error = 'Login gagal. Coba lagi.';

const session = await getCurrentUser(Astro);
if (session) return Astro.redirect('/dashboard');
---

<Layout title="Login — Tabungan SDN Klagen 1">
  <section class="space-y-6 pt-6">
    <header class="flex flex-col items-center space-y-1 text-center">
      <Piggy class="w-20 h-auto" />
      <h1 class="text-2xl font-semibold">Masuk Guru</h1>
      <p class="text-sm text-ink/60">Khusus guru. Gunakan akun yang terdaftar.</p>
    </header>

    <form method="POST" action="/api/auth/login" class="space-y-4 rounded-2xl card-soft p-6">
      <label class="block text-sm">
        <span class="mb-1 block font-medium">Email / Username</span>
        <input
          name="email"
          type="email"
          required
          autocomplete="username"
          class="w-full rounded-xl border-2 border-ink/10 bg-white px-3 py-2 text-base outline-none focus:border-brand"
        />
      </label>

      <label class="block text-sm">
        <span class="mb-1 block font-medium">Password</span>
        <input
          name="password"
          type="password"
          required
          autocomplete="current-password"
          class="w-full rounded-xl border-2 border-ink/10 bg-white px-3 py-2 text-base outline-none focus:border-brand"
        />
      </label>

      {error && (
        <p role="alert" class="rounded-md bg-red-100 px-3 py-2 text-sm text-red-800">
          {error}
        </p>
      )}

      <button
        type="submit"
        disabled={loading}
        class="btn-candy-brand w-full rounded-full px-4 py-2.5 text-base disabled:opacity-60"
      >
        {loading ? 'Memproses...' : 'Masuk'}
      </button>
    </form>

    <p class="text-center text-xs text-ink/50">
      <a href="/" class="underline hover:text-brand">Kembali</a>
    </p>
  </section>
</Layout>
