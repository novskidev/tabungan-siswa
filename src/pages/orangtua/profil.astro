---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { getCurrentUser, requireRole } from '../../lib/supabase';

const profile = await requireRole(Astro, 'parent');
const user = await getCurrentUser(Astro);
const email = user?.email ?? '—';
---

<Layout title="Profil — Tabungan SDN Klagen 1">
  <Nav role="parent" current="dashboard" />

  <header class="mb-6">
    <a href="/orangtua" class="text-sm text-ink/60 underline hover:text-ink">
      ← Beranda
    </a>
    <h1 class="mt-1 text-xl font-semibold">Profil</h1>
  </header>

  <dl class="divide-y divide-ink/10 rounded-xl bg-white shadow-sm">
    <div class="flex justify-between px-4 py-3 text-sm">
      <dt class="text-ink/60">Nama</dt>
      <dd class="font-medium">{profile.full_name}</dd>
    </div>
    <div class="flex justify-between px-4 py-3 text-sm">
      <dt class="text-ink/60">Email</dt>
      <dd class="font-medium">{email}</dd>
    </div>
    <div class="flex justify-between px-4 py-3 text-sm">
      <dt class="text-ink/60">Role</dt>
      <dd class="font-medium">Orang Tua</dd>
    </div>
  </dl>

  <form method="POST" action="/api/auth/logout" class="mt-6">
    <button class="w-full rounded-lg bg-ink/5 px-4 py-2.5 text-sm font-medium hover:bg-ink/10">
      Keluar
    </button>
  </form>
</Layout>
