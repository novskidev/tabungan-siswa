// ponytail: root config hanya metadata — main/assets digenerate adapter ke
// dist/server/wrangler.json saat build (main di root memicu error vite-plugin).
// Deploy: `wrangler deploy -c dist/server/wrangler.json` (Pages 404 karena
// @astrojs/cloudflare v14 tidak lagi membuat _worker.js untuk Pages).
{
  "name": "tabungan-siswa",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"]
}
